<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Fody" Version="6.8.1" />
    <PackageVersion Include="FodyHelpers" Version="6.8.1" />
    <PackageVersion Include="FodyPackaging" Version="6.8.1" />
    <PackageVersion Include="Microsoft.CSharp" Version="4.7.0" />
    <PackageVersion Include="FakeItEasy" Version="8.3.0" />
    <PackageVersion Include="Machine.Specifications" Version="1.1.2" />
    <PackageVersion Include="Moq" Version="4.20.70" />
    <PackageVersion Include="NSubstitute" Version="5.1.0" />
    <!-- the sample assembly intentionally references these test frameworks so Scalpel can be tested against them -->
    <PackageVersion Include="NUnit" Version="4.1.0" />
    <PackageVersion Include="xunit" Version="2.9.0" />
    <PackageVersion Include="Verify.Xunit" Version="25.3.0" />
    <!-- the TUnit metapackage is not used since it brings in a Mono.Cecil that conflicts with the Cecil used by Fody -->
    <PackageVersion Include="TUnit.Core" Version="1.69.0" />
    <PackageVersion Include="TUnit.Assertions" Version="1.69.0" />
    <PackageVersion Include="TUnit.Engine" Version="1.69.0" />
  </ItemGroup>
</Project>
